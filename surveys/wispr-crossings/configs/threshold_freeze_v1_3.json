 "amendments": [
  {
   "version": "v1.1",
   "date": "2026-09-05",
   "stage": "pre-dev machinery (no survey frame measured)",
   "items": [
    "affine (2x3) WCS refinement after the translation: a 0.3-deg rotation on the 2024-12-27 recon frame left 1.8 px rms with translation only, 0.75 px after the affine",
    "calibrator S/N >= 15 (was 8), >= 30 calibrators with a linear ZP surface below 60 (was >= 60 quadratic), ZP-scatter gate MAD <= 0.35 mag (was 0.25): at perihelion exposures (15 s) only ~40 Hipparcos V <= 8 stars reach S/N 15, and admitting fainter ones biases the ZP (-21.40 at S/N>=15, -21.28 at >=10, -21.05 at >=8 on the 2024-12-25 04:50 frame: noise-boosted selection); the frozen gates would have dropped most perihelion frames"
   ]
  },
  {
   "version": "v1.2",
   "date": "2026-09-05",
   "stage": "dev-driven, before any confirmatory pixel",
